# URL base da API AWS Lambda / API Gateway (sem barra final)
EXPO_PUBLIC_API_URL=https://seu-api-id.execute-api.us-east-1.amazonaws.com/prod

# Use "false" para consumir o backend real ou "true" para o modo mock local
EXPO_PUBLIC_USE_MOCK_BACKEND=true

# Credenciais OAuth do Google (opcionais — necessárias apenas para login real com Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
