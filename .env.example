# Copy to .env.local for local development (`npm run dev`), and set the same
# variables on Cloud Run. Never commit real values.

# AWS API Gateway URL printed by aws/deploy.sh (also saved in aws/.api-url)
PETMOOD_API_URL="https://<api-id>.execute-api.sa-east-1.amazonaws.com"

# Same value as API_KEY in aws/.env.deploy. On Cloud Run use a Secret Manager reference.
PETMOOD_API_KEY="<shared-api-key>"

# Google OAuth "Web application" client id (public; used by the Google button)
GOOGLE_CLIENT_ID="<id>.apps.googleusercontent.com"
